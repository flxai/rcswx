{
  "name": "rcswx-web-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.html package.json tsconfig.json ../../crates/rcswx-wasm/browser.d.ts",
    "format:check": "prettier --check src tests *.ts *.html package.json tsconfig.json ../../crates/rcswx-wasm/browser.d.ts",
    "check": "npm run format:check && tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
